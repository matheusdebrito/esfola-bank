# Ambiente
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# Porta do backend
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://emprestimo:emprestimo@localhost:5432/emprestimo?schema=public"
POSTGRES_USER=emprestimo
POSTGRES_PASSWORD=emprestimo
POSTGRES_DB=emprestimo
POSTGRES_TEST_DB=emprestimo_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT (gerar valores fortes em produção — nunca commitar segredos reais)
JWT_SECRET=sua_chave_secreta_minimo_32_caracteres_dev
JWT_ISSUER=sistema-emprestimo
JWT_AUDIENCE=sistema-emprestimo-app
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Armazenamento local de documentos
STORAGE_BASE_PATH=./storage/clients
MAX_FILE_SIZE_MB=5

# Logs
LOG_LEVEL=info

# Administrador inicial (criado somente quando não há usuários cadastrados)
ADMIN_EMAIL=admin@emprestimo.local
ADMIN_PASSWORD=Admin@12345